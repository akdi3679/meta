# Validated on boot by lib/env.ts (guide Appendix B)
NODE_ENV=development

# Contact form — Sprint 2
RESEND_API_KEY=
EMAIL_FROM=Meta Roofing Website <leads@metaroofers.com>
LEAD_INBOX=admin@metaroofers.com

# Cloudflare Turnstile (official always-pass TEST keys for dev)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Rate limiting (Upstash Redis REST) — in-memory fallback when empty
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Flip to "on" only after zero CSP violations (guide 48.2)
CSP_ENFORCE=